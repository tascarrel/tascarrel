{
  "name": "tascarrel-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "generate:types": "pnpm generate:schema && pnpm generate:actions",
    "generate:schema": "cd ../crates/libs/tascarrel-api && nix run 'github:silitics/sidex/53f5e11480ebf471ba37a97fa2a683be1e2bf235' -- generate ts ../../../frontend/src/api/generated",
    "generate:actions": "cd ../crates/libs/tascarrel-api && cargo run -q --example generate-ts-bindings > ../../../frontend/src/api/actions.ts",
    "dev": "vite --host 127.0.0.1",
    "test": "node --experimental-strip-types --test src/features/workspaces/creation/model.test.ts src/features/chat/model/contextUsage.test.ts src/features/chat/model/modelPreferences.test.ts src/features/chat/model/podFileLinks.test.ts src/features/settings/tasciPricing.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@pierre/diffs": "^1.2.12",
    "@sidex/types": "^0.0.8",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-router": "^1.170.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.24.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
