{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tascarrel",
  "version": "0.1.0",
  "identifier": "dev.tascarrel.Tascarrel",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Copyright Tascarrel Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "longDescription": "A local-first agentic development environment.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "shortDescription": "Local-first agentic development environment",
    "targets": ["app", "deb", "rpm"]
  }
}
