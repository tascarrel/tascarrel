{
  "name": "tascarrel-desktop",
  "productName": "Tascarrel",
  "version": "0.1.0",
  "description": "Desktop shell for the Tascarrel development environment",
  "author": "Tascarrel Contributors",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/tascarrel/tascarrel",
  "main": "dist/main.js",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "node scripts/prepare-build.mjs && tsc",
    "make": "pnpm run build && electron-forge make",
    "package": "pnpm run build && electron-forge package",
    "start": "pnpm run build && electron-forge start",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@types/node": "^24.0.0",
    "electron": "43.2.0",
    "typescript": "^7.0.2"
  }
}
