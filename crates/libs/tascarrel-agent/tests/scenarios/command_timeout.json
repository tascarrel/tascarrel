{
  "name": "foreground timeout stops the supervised process group",
  "prompt": "Run a command with a short timeout.",
  "responses": [
    {
      "events": [
        { "kind": "tool_call_started", "id": "bash-1", "name": "bash" },
        { "kind": "tool_call_arguments_delta", "id": "bash-1", "delta": "{\"command\":\"sleep 5\",\"timeoutMs\":10}" },
        { "kind": "tool_call_completed", "id": "bash-1" },
