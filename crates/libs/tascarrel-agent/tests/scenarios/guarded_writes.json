      },
      {
        "name": "write",
        "is_error": false,
        "content_contains": "Wrote reports/summary.txt"
      }
    ],
    "file_changes": [
      {
        "path": "existing.txt",
        "operation": "modified",
        "additions": 1,
        "deletions": 1,
        "unified_diff_contains": "--- a/existing.txt\n+++ b/existing.txt"
      },
      {
        "path": "reports/summary.txt",
        "operation": "created",
        "additions": 1,
        "deletions": 0,
        "unified_diff_contains": "--- /dev/null\n+++ b/reports/summary.txt"
