//! Host-owned secret-provider inventory and mutation API.
//!
//! Secret values cross the API only in direct reveal and mutation actions. Subscriptions contain
//! provider capabilities, revisions, names, and safe diagnostics so clients cannot receive secret
//! material accidentally while observing configuration changes.

import workspaces::WorkspaceName

// RPC

/// Reveals one secret from a configured workspace provider.
record RevealSecretAction {
    /// Workspace containing the configured provider.
    workspace_name: WorkspaceName,
    /// Workspace-local provider name.
    provider_name: string,
    /// Name of the secret to reveal.
    secret_name: string,
}

/// Revealed secret material.
record RevealSecretOutput {
    /// Plaintext secret value.
    value: string,
}

/// Creates or replaces one secret in a configured workspace provider.
record SetSecretAction {
    /// Workspace containing the configured provider.
    workspace_name: WorkspaceName,
    /// Workspace-local provider name.
    provider_name: string,
    /// Name of the secret to create or replace.
    secret_name: string,
    /// Plaintext secret value.
    value: string,
    /// Provider revision observed by the client, when one exists.
    expected_revision?: string,
}

/// Result of creating or replacing a secret.
record SetSecretOutput {
    /// Provider revision after the mutation.
    revision: string,
}

/// Deletes one secret from a configured workspace provider.
record DeleteSecretAction {
    /// Workspace containing the configured provider.
    workspace_name: WorkspaceName,
    /// Workspace-local provider name.
    provider_name: string,
    /// Name of the secret to delete.
    secret_name: string,
    /// Provider revision observed by the client, when one exists.
    expected_revision?: string,
}

/// Result of deleting a secret.
record DeleteSecretOutput {
    /// Provider revision after the mutation.
    revision: string,
}

// Subscriptions

/// Subscribes to configured secret-provider metadata for one workspace.
record SecretsChangedSubscription {
    /// Workspace whose provider metadata to receive.
    workspace_name: WorkspaceName,
}

/// Current secret-provider metadata for the selected workspace.
record SecretsChangedEvent {
    /// Configured provider instances in stable name order.
    providers: [SecretProviderMetadata],
}

// Domain Types

/// Safe metadata for one configured secret-provider instance.
record SecretProviderMetadata {
    /// Workspace-local provider name used in secret references.
    name: string,
    /// Stable provider implementation identifier.
    kind: string,
    /// Operations supported by the provider.
    capabilities: SecretProviderCapabilities,
    /// Revision of the provider's encrypted source, when it exists and can be read.
    revision?: string,
    /// Secret entries in stable name order.
    secrets: [SecretMetadata],
    /// Current provider failure, when its source cannot be read or decrypted.
    error?: SecretProviderError,
}

/// Operations supported by a secret-provider instance.
record SecretProviderCapabilities {
    /// Whether clients may reveal secret values.
    reveal: bool,
    /// Whether clients may create and replace secret values.
    set: bool,
    /// Whether clients may delete secret values.
    delete: bool,
}

/// Safe metadata for one secret entry.
record SecretMetadata {
    /// Name addressable through the provider namespace.
    name: string,
}

/// Provider failure safe to display without exposing secret material.
record SecretProviderError {
    /// Human-readable failure diagnostic without secret values.
    message: string,
}
