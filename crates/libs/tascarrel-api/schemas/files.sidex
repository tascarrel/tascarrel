//! Pod file inspection API implemented by the workspace guest daemon.
//!
//! A file root identifies either `/workspace` or one configured host share exposed below `/mnt`.
//! Paths are normalized UTF-8 paths relative to that root; the empty path identifies the root
//! itself. Directory reads are point-in-time traversals and are deliberately not cached. Symbolic
//! links are returned as entries but are never followed while resolving a request.
//!
//! File bodies are read and replaced through guest data-plane requests and are not embedded in
//! Sidex control-plane messages. Browser replacements are bounded, UTF-8, complete-file writes
//! guarded by an observed content revision.

import pods::PodId

// RPC

/// Lists the file roots available to one pod.
record ListRootsAction {
    /// Pod whose configured file roots are listed.
    pod_id: PodId,
}

/// Configured file roots available to the pod.
record ListRootsOutput {
    /// Roots ordered with the workspace first and shares by name.
    roots: [FileRoot],
}

/// Reads the immediate children of one directory below a pod file root.
record ReadDirectoryAction {
    /// Pod whose file root is inspected.
    pod_id: PodId,
    /// Logical root containing the directory, defaulting to the workspace when absent.
    root?: FileRoot,
    /// Directory to read, using the empty path for the selected root.
    path: FilePath,
}

/// Point-in-time directory contents.
record ReadDirectoryOutput {
    /// Immediate children ordered by name.
    entries: [FileEntry],
}

// Subscriptions

// Domain Types

/// Logical root available in one pod.
#[rust(derive(Eq, Hash, Ord, PartialOrd))]
variant FileRoot {
    /// The pod's persistent `/workspace` directory.
    Workspace,
    /// One configured host share exposed at `/mnt/<name>`.
    Share: ShareFileRoot,
}

/// One configured host-share root.
#[rust(derive(Eq, Hash, Ord, PartialOrd))]
record ShareFileRoot {
    /// Validated workspace-local share name.
    name: string,
}

/// Normalized UTF-8 path relative to a pod file root.
///
/// The empty path identifies the root. Paths are at most 4,096 encoded bytes. Absolute paths,
/// empty components, trailing separators, and `.` or `..` components are invalid.
#[rust(derive(Eq, Hash, Ord, PartialOrd))]
wrapper FilePath: string

/// One immediate child returned by a directory read.
record FileEntry {
    /// Final path component used for display and ordering.
    name: string,
    /// Filesystem kind observed without following symbolic links.
    kind: FileKind,
    /// Byte length for a regular file, or absent for other filesystem kinds.
    size?: u64,
    /// Git status for a directly changed file, or absent for directories and unchanged paths.
    git_status?: FileGitStatus,
}

/// Filesystem kind observed for one directory entry.
variant FileKind {
    /// Regular file.
    File,
    /// Directory.
    Directory,
    /// Symbolic link.
    Symlink,
    /// Socket, device, FIFO, or another special filesystem object.
    Other,
}

/// Git index and worktree state annotating one directly changed file.
record FileGitStatus {
    /// Previous path reported for a renamed or copied file.
    previous_path?: FilePath,
    /// Change between `HEAD` and the index, when present.
    index?: GitChangeKind,
    /// Change between the index and worktree, when present.
    worktree?: GitChangeKind,
}

/// Git change classification used to annotate file tree entries.
variant GitChangeKind {
    /// Path was added.
    Added,
    /// Path contents changed.
    Modified,
    /// Path was deleted.
    Deleted,
    /// Path moved from another location.
    Renamed,
    /// Path was copied from another location.
    Copied,
    /// Filesystem or Git object type changed.
    TypeChanged,
    /// Path has unresolved merge stages.
    Unmerged,
    /// Path is not tracked by Git.
    Untracked,
}
