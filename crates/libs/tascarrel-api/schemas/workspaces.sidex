//! Workspace lifecycle and inventory API implemented by the host daemon.
//!
//! Actions create and destroy workspaces, control their VMs, and forward host USB devices into a
//! running VM. A workspace's mutable state is stored on its state partition. Stopping the VM
//! retains the workspace configuration and state partition, while destroying the workspace removes
//! both. Subscriptions expose the host's workspace list, VM logs, and live USB forwarding state.
//! The workspace list uses the generic tascarrel-store wire model for resumption.
//!
//! The host daemon parses VM serial-console output into lines and truncates content beyond the
//! configured line length. Each VM instance retains a bounded line history. Its subscription uses
//! line numbers for resumption. A subscriber receives retained lines after its last observed line
//! followed by live lines in non-empty ordered batches. A jump in line numbers indicates that
//! intervening lines have been evicted.

import common::Timestamp
import guest::GuestInstanceId
import store::{Stamp, StoreEvent}

// RPC

/// Creates one stopped workspace from a supplied or default development definition.
record CreateWorkspaceAction {
    /// Name to assign to the workspace.
    name: WorkspaceName,
    /// Initial configuration files, or the minimal Tascarrel definition when omitted.
    definition?: WorkspaceCreationDefinition,
    /// Initial provider values encrypted by hostd before the workspace is published.
    /// Values are confidential request data. Every referenced provider must be configured as a
    /// SOPS provider in the supplied `config.toml`.
    initial_secrets?: [WorkspaceCreationSecret],
}

/// Result of creating one workspace.
record CreateWorkspaceOutput {}

/// Starts the VM of one stopped workspace.
record StartWorkspaceAction {
    /// Workspace whose VM to start.
    workspace: WorkspaceName,
}

/// Result of starting one workspace VM.
record StartWorkspaceOutput {}

/// Stops one workspace VM while retaining its configuration and state partition.
record StopWorkspaceAction {
    /// Workspace whose VM to stop.
    workspace: WorkspaceName,
}

/// Result of stopping one workspace VM.
record StopWorkspaceOutput {}

/// Destroys one workspace, its configuration, and its VM state partition.
record DestroyWorkspaceAction {
    /// Workspace to destroy.
    workspace: WorkspaceName,
}

/// Result of destroying one workspace.
record DestroyWorkspaceOutput {}

/// Attaches one connected host USB device to a running workspace VM.
record AttachUsbDeviceAction {
    /// Workspace receiving the USB device.
    workspace: WorkspaceName,
    /// Connection-scoped device selected from the live host USB inventory.
    device_id: UsbDeviceId,
}

/// Result of attaching one host USB device; its resulting state is observed
/// through [`UsbDevicesChangedSubscription`].
record AttachUsbDeviceOutput {}

/// Detaches one host USB device from a running workspace VM.
record DetachUsbDeviceAction {
    /// Workspace currently receiving the USB device.
    workspace: WorkspaceName,
    /// Connection-scoped device to detach.
    device_id: UsbDeviceId,
}

/// Result of detaching one host USB device; its resulting state is observed
/// through [`UsbDevicesChangedSubscription`].
record DetachUsbDeviceOutput {}

// Subscriptions

/// Subscribes to the host-wide workspace list and workspace lifecycle changes.
record WorkspaceListChangedSubscription {
    /// Stamp of the last store event applied by the consumer, when resuming.
    cursor?: Stamp,
}

/// Resumable event emitted by the host-wide workspace list.
record WorkspaceListChangedEvent {
    /// Snapshot or mutation used to advance the consumer's cached workspace list.
    change: StoreEvent<WorkspaceList, WorkspaceListMutation>,
}

/// Subscribes to retained and live serial-console log lines for one workspace VM instance.
record WorkspaceVmLogSubscription {
    /// VM instance whose serial-console log to receive.
    guest_instance_id: GuestInstanceId,
    /// Last line already observed by the consumer, or absent to receive all retained lines.
    last_line?: u64,
}

/// One non-empty batch of retained or live workspace VM log lines.
record WorkspaceVmLogEvent {
    /// Ordered serial-console lines from the workspace VM instance.
    lines: [WorkspaceVmLogLine],
}

/// Subscribes to the live host USB inventory and forwarding state for one workspace.
record UsbDevicesChangedSubscription {
    /// Workspace from whose perspective USB device availability is observed.
    workspace: WorkspaceName,
}

/// Current host USB inventory and forwarding state.
record UsbDevicesChangedEvent {
    /// Whether host USB forwarding is supported by this host and workspace mode.
    supported: bool,
    /// Connected host USB devices ordered by host connection address.
    devices: [UsbDevice],
}

// Domain Types

/// Identifies one workspace owned by the host daemon.
///
/// Names contain 1-64 ASCII letters, digits, `_`, or `-`.
#[rust(derive(Eq, Hash, Ord, PartialOrd))]
wrapper WorkspaceName: string

/// Complete generated input used to initialize a new workspace.
record WorkspaceCreationDefinition {
    /// UTF-8 contents to write to the workspace's `config.toml`.
    config_toml: string,
    /// UTF-8 contents to write to the workspace image's root `Dockerfile`.
    dockerfile: string,
    /// UTF-8 contents to write to the workspace instruction overlay's `AGENTS.md`.
    agents_md: string,
}

/// One confidential provider value supplied while creating a workspace.
record WorkspaceCreationSecret {
    /// Configured SOPS provider receiving the value.
    provider_name: string,
    /// Name to assign within the provider document.
    secret_name: string,
    /// Plaintext value retained only long enough for hostd to encrypt and verify the document.
    value: string,
}

/// Identifies one physical USB connection observed by the host daemon;
/// disconnecting and reconnecting may assign a new identifier.
#[rust(derive(Eq, Hash, Ord, PartialOrd))]
wrapper UsbDeviceId: string

/// One retained workspace VM serial-console line.
record WorkspaceVmLogLine {
    /// Monotonically increasing line number within the VM instance log, starting at one.
    line: u64,
    /// Text content without its line terminator.
    content: string,
    /// Whether content beyond the configured line length was discarded.
    truncated: bool,
}

/// One physical USB device connected to the host.
record UsbDevice {
    /// Connection-scoped identifier used by attach and detach actions.
    id: UsbDeviceId,
    /// Human-readable device name suitable for display.
    name: string,
    /// Manufacturer reported by the device, when available.
    manufacturer?: string,
    /// Product name reported by the device, when available.
    product?: string,
    /// USB vendor identifier.
    vendor_id: u16,
    /// USB product identifier.
    product_id: u16,
    /// Serial number reported by the device, when available.
    serial_number?: string,
    /// Whether hostd has the usbfs permissions required for forwarding.
    has_required_permissions: bool,
    /// Workspace currently receiving the device, when it is forwarded.
    forwarded_to?: WorkspaceName,
}

/// One workspace managed by the host daemon.
record Workspace {
    /// Stable user-chosen workspace name.
    name: WorkspaceName,
    /// Current workspace and VM lifecycle state.
    state: WorkspaceState,
}

/// Current lifecycle state of a workspace.
#[json(tag = "status")]
variant WorkspaceState {
    /// The workspace exists with its VM stopped and its state partition retained.
    Stopped,
    /// A new workspace VM instance is becoming ready.
    Starting: WorkspaceVmInstance,
    /// The workspace VM and its guest daemon are available.
    Running: WorkspaceVmInstance,
    /// The workspace VM instance is shutting down.
    Stopping: WorkspaceVmInstance,
    /// The workspace configuration and VM state partition are being destroyed.
    Destroying,
    /// The workspace could not complete a lifecycle transition.
    Failed: WorkspaceFailure,
}

/// Identity of one workspace VM incarnation.
record WorkspaceVmInstance {
    /// Guest instance assigned when this VM incarnation started.
    guest_instance_id: GuestInstanceId,
}

/// Failure encountered while changing a workspace lifecycle state.
record WorkspaceFailure {
    /// VM incarnation involved in the failed transition, when one was assigned.
    guest_instance_id?: GuestInstanceId,
    /// Human-readable failure diagnostic.
    message: string,
    /// Time at which the lifecycle transition failed.
    failed_at: Timestamp,
}

/// Complete host-wide workspace list.
record WorkspaceList {
    /// Workspaces ordered by name.
    workspaces: [Workspace],
}

/// Mutation applied to the host-wide workspace list.
#[json(tag = "type")]
variant WorkspaceListMutation {
    /// Adds a workspace or replaces the existing entry.
    Upsert: Workspace,
    /// Removes a workspace from the list.
    Remove: WorkspaceName,
}
